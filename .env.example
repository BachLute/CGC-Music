# Vercel Postgres — populated automatically when you link a Postgres database
# to this project in the Vercel dashboard (Storage tab). For local development,
# copy the values from Vercel (Project Settings > Environment Variables) or run
# `vercel env pull .env.local`.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Anthropic API key, used by the "Run now" search feature.
ANTHROPIC_API_KEY=

# Gmail SMTP credentials used to send outreach emails. GMAIL_USER must be a
# Gmail account that is configured to send as info@classicalguitarceremonies.com
# (Gmail Settings > Accounts > "Send mail as"), and GMAIL_APP_PASSWORD must be
# a 16-character App Password generated for that account (requires 2-Step
# Verification to be enabled) — not the regular account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Plain-text mailing address appended to the footer of every outreach email.
BUSINESS_ADDRESS="Classical Guitar Ceremonies, 123 Main St, Anytown, ST 00000"
